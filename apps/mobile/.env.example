# Copy to .env.local and fill in. .env*.local is gitignored.
#
# EXPO_PUBLIC_* is the only prefix Expo inlines into the JS bundle, so these
# three are the ONLY variables that may live here. Anything secret — the
# service-role key, the Anthropic key, the Stripe keys — must never appear in a
# mobile env file: EXPO_PUBLIC_ values are compiled into the shipped binary and
# are readable by anyone who downloads the app. The anon key is safe here for
# the same reason it is safe in the web bundle: every table is behind RLS and
# the key grants nothing without a valid user JWT.

# The same values the web app uses (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the Next.js API lives.
#   Production   https://phare.money
#   Local web    http://<your-LAN-IP>:3000   ← NOT localhost: on a physical
#                device localhost is the phone itself. An emulator can use
#                http://10.0.2.2:3000 (Android) instead.
EXPO_PUBLIC_API_URL=https://phare.money
